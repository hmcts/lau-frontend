{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% set isAuditInvestigator = userRoles and 'cft-audit-investigator' in userRoles %}
{% set isServiceLogs = userRoles and 'cft-service-logs' in userRoles %}

{% if env === 'development' and not idamEnabled %}
  {% set accountNavigation = [
    {
      href: "/unset-role/cft-audit-investigator" if isAuditInvestigator else "/set-role/cft-audit-investigator",
      text: "Unset CFT_AUDIT_INVESTIGATOR" if isAuditInvestigator else "Set CFT_AUDIT_INVESTIGATOR"
    },
    {
      href: "/unset-role/cft-service-logs" if isServiceLogs else "/set-role/cft-service-logs",
      text: "Unset CFT_SERVICE_LOGS" if isServiceLogs else "Set CFT_SERVICE_LOGS"
    }
  ] %}
{% else %}
  {% set accountNavigation = [
    {
      href: "/logout" if isLoggedIn else "/login",
      text: "Logout" if isLoggedIn else "Login"
    }
  ] %}
{% endif %}

{# Falsy entries are dropped by the macro, so role-gated items use `if` without `else` #}
{% set pageNavigation = [
  { href: "/case-audit", text: "Case audit", current: caseSearchPage } if isAuditInvestigator,
  { href: "/challenged-specific-access", text: "Challenged & specific access", current: challengedSpecificAccessPage } if isAuditInvestigator,
  { href: "/logon-audit", text: "Log ons audit", current: logonSearchPage } if isAuditInvestigator,
  { href: "/user-deletion-audit", text: "Deleted users", current: userDeletionSearchPage } if isAuditInvestigator,
  { href: "/user-details-audit", text: "User details", current: userDetailsPage } if isAuditInvestigator and userDetailsEnabled,
  { href: "/case-deletion-audit", text: "Case deletions", current: caseDeletionSearchPage } if isServiceLogs
] %}

{{ govukServiceNavigation({
  serviceName: "Log and Audit",
  serviceUrl: "/",
  navigation: pageNavigation.concat(accountNavigation)
}) }}
