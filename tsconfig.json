{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "lib": [
      "es2022",
      "es2022.object",
      "dom"
    ],
    "paths": {
      "router/*": [
        "./src/main/router/*"
      ],
      "routes/*": [
        "./src/main/routes/*"
      ]
    },
    "types": ["node", "express"]
  },
  "include": ["src/main/**/*.ts"]
}
